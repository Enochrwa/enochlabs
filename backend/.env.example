PROJECT_NAME=EnochLabs API
ENVIRONMENT=development
DEBUG=true

# Postgres connection string
DATABASE_URL=postgresql+psycopg://enochlabs:enochlabs@localhost:5432/enochlabs

# Comma-separated list is not supported directly by pydantic-settings for list fields
# via .env — set via JSON array syntax if overriding, e.g.:
# CORS_ORIGINS=["http://localhost:5173","https://enochlabs.dev"]

# Optional: webhook to notify on new inquiries (e.g. a Slack/Zapier/email relay webhook)
INQUIRY_NOTIFY_WEBHOOK=
