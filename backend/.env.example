PROJECT_NAME=EnochLabs API
ENVIRONMENT=development
DEBUG=true

# Postgres connection string
DATABASE_URL=postgresql+psycopg://enochlabs:enochlabs@localhost:5432/enochlabs

# Plain comma-separated list of allowed frontend origins (no JSON needed —
# easy to paste as a single-line value into a hosting dashboard, e.g. Render):
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: webhook to notify on new inquiries (e.g. a Slack/Zapier/email relay webhook)
INQUIRY_NOTIFY_WEBHOOK=
