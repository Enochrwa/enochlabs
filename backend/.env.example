PROJECT_NAME=EnochLabs API
ENVIRONMENT=development
DEBUG=true

# Postgres connection string
DATABASE_URL=postgresql+psycopg://enochlabs:enochlabs@localhost:5432/enochlabs

# Plain comma-separated list of allowed frontend origins (no JSON needed —
# easy to paste as a single-line value into a hosting dashboard, e.g. Render):
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: webhook to notify on new inquiries (e.g. a Slack/Zapier/email relay webhook)
INQUIRY_NOTIFY_WEBHOOK=

# Shape of the payload sent to INQUIRY_NOTIFY_WEBHOOK: generic | slack | discord
# (Slack/Discord incoming webhooks expect a specific single-field payload —
# see docs/DEPLOYMENT.md "Configuring inquiry notifications")
INQUIRY_NOTIFY_WEBHOOK_FORMAT=generic

# Rate limiting for POST /api/v1/inquiries, per client IP (spam protection —
# no CAPTCHA dependency). Defaults are generous; tighten if you see abuse.
INQUIRY_RATE_LIMIT_MAX=20
INQUIRY_RATE_LIMIT_WINDOW_SECONDS=3600

# Shared secret required in the X-Admin-Key header to call GET /api/v1/inquiries
# and to unlock the frontend's /admin view. Unset by default — the admin
# endpoint refuses every request until this is set. Use a long random value.
ADMIN_API_KEY=
