# Base URL of the FastAPI backend (see ../backend)
VITE_API_URL=http://localhost:8000

# WhatsApp business number for the direct-contact channel (international format, no +)
VITE_WHATSAPP_NUMBER=250780000000

# Public site URL. Used at build time to fill in canonical/Open Graph/Twitter-card
# URLs in index.html and to generate dist/sitemap.xml and dist/robots.txt.
# Falls back to the value below if unset, so builds never fail without it.
VITE_SITE_URL=https://enochlabs.dev

# Analytics (optional)
VITE_PLAUSIBLE_DOMAIN=
