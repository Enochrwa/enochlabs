{
  "name": "enochlabs-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "EnochLabs marketing site — React, TypeScript, Vite, Tailwind CSS, Radix UI.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "postbuild": "node scripts/generate-seo-files.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --noEmit",
    "lighthouse": "lhci autorun"
  },
  "dependencies": {
    "@fontsource/fraunces": "5.1.1",
    "@fontsource/ibm-plex-mono": "5.1.1",
    "@fontsource/inter": "5.1.1",
    "@radix-ui/react-navigation-menu": "1.2.1",
    "@radix-ui/react-slot": "1.1.0",
    "class-variance-authority": "0.7.0",
    "clsx": "2.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0",
    "tailwind-merge": "2.5.5"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@types/node": "20.17.6",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@typescript-eslint/eslint-plugin": "8.15.0",
    "@typescript-eslint/parser": "8.15.0",
    "@vitejs/plugin-react": "4.3.3",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-react-hooks": "4.6.2",
    "eslint-plugin-react-refresh": "0.4.14",
    "postcss": "8.4.49",
    "prettier": "3.3.3",
    "prettier-plugin-tailwindcss": "0.6.9",
    "tailwindcss": "3.4.15",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
